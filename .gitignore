# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Plastic SCM (Unity Version Control)
/Assets/Plugins/PlasticSCM*
**/Assets/AssetStoreTools*
~UnityDirMonSyncFile~*

# Addressables
**/Assets/AddressableAssetsData/*/*.bin*

# OS
.DS_Store*
Thumbs.db
Desktop.ini

